---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | Código Ágil">
	<div class="max-w-3xl mx-auto">
		<div class="text-center mb-10 reveal">
			<h1 class="text-4xl md:text-5xl font-extrabold text-[#687284] mb-4 tracking-tight">Hablemos de tu Proyecto</h1>
			<p class="text-lg text-[#687284] opacity-90 leading-relaxed">Completa el formulario y uno de nuestros arquitectos de software o especialistas en seguridad se pondrá en contacto contigo en menos de 24 horas.</p>
		</div>

		<div class="bg-[#E8F8EE] p-8 md:p-12 rounded-3xl shadow-sm border border-[#D8DEE6] reveal" style="transition-delay: 0.1s;">
			<form class="space-y-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label for="nombre" class="block text-sm font-semibold text-[#687284] mb-2">Nombre completo</label>
						<input type="text" id="nombre" name="nombre" class="w-full rounded-2xl border-[#D8DEE6] shadow-sm focus:border-[#69BC83] focus:ring-[#69BC83] p-4 border bg-[#FFFFFF] text-[#687284] outline-none transition-all duration-300" required />
					</div>
					<div>
						<label for="empresa" class="block text-sm font-semibold text-[#687284] mb-2">Empresa</label>
						<input type="text" id="empresa" name="empresa" class="w-full rounded-2xl border-[#D8DEE6] shadow-sm focus:border-[#69BC83] focus:ring-[#69BC83] p-4 border bg-[#FFFFFF] text-[#687284] outline-none transition-all duration-300" />
					</div>
				</div>

				<div>
					<label for="email" class="block text-sm font-semibold text-[#687284] mb-2">Correo corporativo</label>
					<input type="email" id="email" name="email" class="w-full rounded-2xl border-[#D8DEE6] shadow-sm focus:border-[#69BC83] focus:ring-[#69BC83] p-4 border bg-[#FFFFFF] text-[#687284] outline-none transition-all duration-300" required />
				</div>

				<div>
					<label for="asunto" class="block text-sm font-semibold text-[#687284] mb-2">Área de interés</label>
					<select id="asunto" name="asunto" class="w-full rounded-2xl border-[#D8DEE6] shadow-sm focus:border-[#69BC83] focus:ring-[#69BC83] p-4 border bg-[#FFFFFF] text-[#687284] outline-none transition-all duration-300">
						<option>Desarrollo de Software a Medida</option>
						<option>Auditoría de Ciberseguridad / Pentesting</option>
						<option>Consultoría y Arquitectura Cloud</option>
						<option>Otro</option>
					</select>
				</div>

				<div>
					<label for="mensaje" class="block text-sm font-semibold text-[#687284] mb-2">Detalles del proyecto</label>
					<textarea id="mensaje" name="mensaje" rows="5" class="w-full rounded-2xl border-[#D8DEE6] shadow-sm focus:border-[#69BC83] focus:ring-[#69BC83] p-4 border bg-[#FFFFFF] text-[#687284] outline-none transition-all duration-300" required></textarea>
				</div>

				<button type="submit" class="w-full bg-[#69BC83] text-[#FFFFFF] font-bold py-4 px-4 rounded-full hover:bg-[#56A772] transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1 text-lg">
					Enviar Solicitud
				</button>
			</form>
		</div>
	</div>
</Layout>