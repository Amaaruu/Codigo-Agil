---
import Layout from '../layouts/Layout.astro';

const hero = {
  badge: "Catálogo de Servicios",
  title: "Ingeniería de software",
  highlight: "y ciberseguridad.",
  description: "Diseñamos, desarrollamos y protegemos arquitecturas digitales. Nuestro enfoque combina rendimiento, escalabilidad y seguridad desde la primera línea de código para garantizar el éxito de tu producto."
};

const servicios = [
  {
    title: "Desarrollo Web & Plataformas",
    description: "Creamos experiencias web ultrarrápidas, accesibles y optimizadas para SEO. Desde landing pages corporativas hasta plataformas transaccionales complejas.",
    features: ["Sitios web corporativos", "Plataformas E-commerce", "Sistemas CMS Headless", "Optimización de rendimiento (Core Web Vitals)"],
    icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
  },
  {
    title: "Software a Medida (SaaS/ERP)",
    description: "Construimos el núcleo digital de tu empresa. Desarrollamos sistemas de gestión interna, automatización de procesos y plataformas SaaS completas.",
    features: ["Sistemas de gestión empresarial (ERP/CRM)", "Paneles de control y Dashboards", "Automatización de flujos de trabajo", "Desarrollo y consumo de APIs (REST/GraphQL)"],
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
  },
  {
    title: "Desarrollo Móvil",
    description: "Llevamos tu negocio al bolsillo de tus clientes. Aplicaciones nativas y multiplataforma diseñadas para ofrecer una experiencia de usuario impecable.",
    features: ["Aplicaciones iOS y Android", "Desarrollo Multiplataforma (React Native)", "Aplicaciones Web Progresivas (PWA)", "Integración con hardware del dispositivo"],
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
  },
  {
    title: "Inteligencia Artificial & Datos",
    description: "Implementamos soluciones inteligentes que aprenden y optimizan tus operaciones, convirtiendo grandes volúmenes de datos en decisiones estratégicas.",
    features: ["Integración de modelos LLM (ChatGPT, Claude)", "Agentes conversacionales (Chatbots)", "Análisis predictivo de datos", "Automatización Robótica de Procesos (RPA)"],
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    title: "Arquitectura Cloud & DevOps",
    description: "Diseñamos infraestructuras en la nube preparadas para soportar alta demanda sin interrupciones, optimizando costos y facilitando despliegues continuos.",
    features: ["Migración y gestión en AWS/Azure/GCP", "Contenedores (Docker & Kubernetes)", "Pipelines de despliegue (CI/CD)", "Monitoreo de rendimiento 24/7"],
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
  },
  {
    title: "Auditoría & Ciberseguridad",
    description: "Evaluamos y blindamos tu software contra amenazas externas. Identificamos vulnerabilidades antes de que puedan ser explotadas por atacantes.",
    features: ["Pruebas de penetración (Pentesting)", "Auditoría de código fuente", "Implementación de normativas y compliance", "Arquitecturas Zero-Trust y encriptación"],
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  }
];

const proceso = [
  { step: "01", name: "Análisis", desc: "Evaluamos requerimientos y arquitectura." },
  { step: "02", name: "Diseño", desc: "Prototipado técnico y UX/UI." },
  { step: "03", name: "Ejecución", desc: "Desarrollo iterativo con entregas continuas." },
  { step: "04", name: "Entrega", desc: "Pruebas, despliegue y soporte." }
];
---

<Layout title="Servicios | Código Ágil" fullWidth={true}>
	<section class="pt-32 pb-24 bg-[#FFFFFF] w-full border-b border-[#D8DEE6]">
		<div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8 reveal">
			<span class="text-[#69BC83] font-bold tracking-widest uppercase text-sm mb-6 block">{hero.badge}</span>
			<h1 class="text-5xl md:text-7xl font-extrabold text-[#687284] mb-8 leading-tight tracking-tight">
				{hero.title} <br />
				<span class="text-[#69BC83]">{hero.highlight}</span>
			</h1>
			<p class="text-xl text-[#687284] leading-relaxed max-w-3xl mx-auto opacity-90">
				{hero.description}
			</p>
		</div>
	</section>

	<section class="py-24 bg-[#FAFAFA] w-full">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
				{servicios.map((servicio, index) => (
					<div class="bg-[#FFFFFF] p-10 md:p-12 rounded-[2.5rem] shadow-sm border border-[#D8DEE6] hover:shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-500 hover:-translate-y-1 reveal group" style={`transition-delay: ${index * 0.1}s;`}>
						<div class="w-16 h-16 bg-[#E8F8EE] text-[#69BC83] rounded-2xl flex items-center justify-center mb-8 group-hover:bg-[#69BC83] group-hover:text-[#FFFFFF] transition-colors duration-300">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={servicio.icon}></path>
							</svg>
						</div>
						<h2 class="text-3xl font-extrabold text-[#687284] mb-4 tracking-tight">{servicio.title}</h2>
						<p class="text-lg text-[#687284] opacity-90 leading-relaxed mb-8">{servicio.description}</p>
						
						<div class="border-t border-[#D8DEE6] pt-8">
							<h3 class="text-sm font-bold text-[#687284] uppercase tracking-wider mb-5">Incluye:</h3>
							<ul class="space-y-3">
								{servicio.features.map(feature => (
									<li class="flex items-start">
										<span class="text-[#69BC83] mr-3 font-bold mt-1">✓</span>
										<span class="text-[#687284] font-medium opacity-90">{feature}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="py-32 bg-[#FFFFFF] w-full border-y border-[#D8DEE6]">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-3xl mx-auto mb-20 reveal">
				<h2 class="text-4xl md:text-5xl font-extrabold text-[#687284] mb-6 tracking-tight">Cómo trabajamos</h2>
				<p class="text-xl text-[#687284] opacity-80 leading-relaxed">Nuestra metodología ágil asegura entregas constantes, mitigación de riesgos y un producto final alineado a tus expectativas comerciales.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
				{proceso.map((proc, index) => (
					<div class="reveal relative" style={`transition-delay: ${index * 0.1}s;`}>
						<div class="hidden lg:block absolute top-8 left-16 w-full h-[2px] bg-gradient-to-r from-[#69BC83] to-transparent z-0 opacity-30"></div>
						<div class="relative z-10">
							<span class="text-6xl font-black text-[#E8F8EE] block mb-2">{proc.step}</span>
							<h3 class="text-2xl font-bold text-[#687284] mb-3">{proc.name}</h3>
							<p class="text-[#687284] opacity-90 leading-relaxed">{proc.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="py-24 my-10 w-full">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-[#000000] rounded-[3rem] p-12 md:p-24 text-center reveal relative overflow-hidden">
				<div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[#69BC83] via-[#000000] to-[#000000]"></div>
				<div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-[#69BC83] via-[#000000] to-[#000000]"></div>
				
				<div class="relative z-10">
					<h2 class="text-4xl md:text-6xl font-extrabold text-[#FFFFFF] mb-8 tracking-tight">No dejes tu tecnología al azar.</h2>
					<p class="text-xl text-[#FFFFFF] opacity-80 mb-12 max-w-3xl mx-auto leading-relaxed">
						Nuestros arquitectos de software están listos para analizar tu proyecto, definir la tecnología adecuada y comenzar a construir.
					</p>
					<a href="/contacto" class="inline-block bg-[#69BC83] text-[#FFFFFF] font-bold py-5 px-12 rounded-full hover:bg-[#56A772] transition-all duration-300 shadow-[0_0_20px_rgb(105,188,131,0.4)] hover:shadow-[0_0_30px_rgb(105,188,131,0.6)] hover:-translate-y-1 text-xl">
						Solicitar Auditoría Técnica →
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>